# Usado somente pelo perfil de monitoramento do Docker Compose.
# Defina uma senha própria antes de iniciar o Grafana.
GRAFANA_ADMIN_PASSWORD=

# Opcional: servidor de turma e tutoria. Use valores próprios, nunca os de teste.
# Mínimo: código com 8 caracteres; chave do docente com 12 caracteres.
LEARNING_CLASS_CODE=
LEARNING_TEACHER_KEY=
# Diretório persistente privado do processo Node. Não publique estes arquivos.
# BIOENERGIA_DATA_DIR=/caminho/privado/bioenergia
